flowchart TB
    U[Admin / Viewer]
    V[Vercel Frontend]
    R[Render FastAPI Backend]
    SA[Supabase Auth]
    DB[(Supabase PostgreSQL + RLS)]
    ST[(Supabase Storage)]
    SEC[Platform Secret Stores]
    SEN[Sentry]

    U -->|HTTPS/TLS| V
    V -->|JWT Bearer + CORS| R
    V -->|Auth Sign-in / Refresh| SA
    R -->|Token validation| SA
    R -->|SQL over TLS| DB
    R -->|Signed access| ST
    V -->|Frontend telemetry| SEN
    R -->|Backend telemetry| SEN

    SEC -->|Runtime secrets| V
    SEC -->|Runtime secrets| R
    SEC -->|DB/Auth secrets| SA

    classDef security fill:#f3f8ff,stroke:#4a6cf7,stroke-width:1px;
    class V,R,SA,DB,ST,SEC,SEN security;
