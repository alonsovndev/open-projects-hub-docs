{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "open-projects-hub-docs",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./build",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "oph-docs.alonsovndev.com",
      "custom_domain": true
    }
  ],
  "previews": {}
}
